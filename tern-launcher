#!/usr/bin/env python3
import json
import os
from pathlib import Path
import re
import select
import shlex
import subprocess
import sys
import termios
import time

APC = "\x1b_tsp;"
ST = "\x1b\\"
SURFACE = "s:1"
PARAM = re.compile(r"^[A-Za-z0-9_-]+=[\x21-\x3a\x3c-\x7e]*$")
KEYS = {
    "\x1b[A": "up", "\x1b[B": "down", "\x1bOA": "up", "\x1bOB": "down",
    "\r": "enter", "\n": "enter", "\x7f": "backspace", "\x08": "backspace", "\x1b": "escape",
    "\x1b[5~": "pageup", "\x1b[6~": "pagedown",
}
SEQS = sorted(KEYS, key=len, reverse=True)
PREFIXES = [APC] + SEQS


def message(verb, params, text):
    base = "".join(f";{k}={v}" for k, v in params.items())
    return f"{APC}{verb}{base};{text}{ST}"


def frame(verb, body):
    return message(verb, {}, json.dumps(body, separators=(",", ":")))


def send(text):
    data = text.encode()
    while data:
        data = data[os.write(1, data):]


def parse(data):
    out = []
    i = 0
    while i < len(data):
        if data.startswith(APC, i):
            end = data.find(ST, i)
            if end == -1:
                break
            verb, _, rest = data[i + len(APC):end].partition(";")
            parts = rest.split(";")
            while parts and PARAM.match(parts[0]):
                parts.pop(0)
            try:
                payload = json.loads(";".join(parts))
            except ValueError:
                payload = None
            if verb in ("r", "e") and isinstance(payload, dict):
                out.append(("tsp", payload))
            i = end + len(ST)
            continue
        tail = data[i:]
        if any(len(s) > len(tail) and s.startswith(tail) for s in PREFIXES):
            break
        for seq in SEQS:
            if data.startswith(seq, i):
                out.append((KEYS[seq], None))
                i += len(seq)
                break
        else:
            ch = data[i]
            out.append(("char", ch) if ord(ch) >= 32 else ("ctrl", chr(ord(ch) + 96)))
            i += 1
    return out, data[i:]


def desktop_entries():
    dirs = [os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "applications")]
    dirs += [os.path.join(d, "applications") for d in os.environ.get("XDG_DATA_DIRS", "/run/current-system/sw/share").split(":") if d]
    seen = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".desktop") or name in seen:
                continue
            fields = {}
            section = None
            try:
                with open(os.path.join(d, name), encoding="utf-8", errors="replace") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("["):
                            section = line
                        elif section == "[Desktop Entry]" and "=" in line:
                            k, _, v = line.partition("=")
                            fields.setdefault(k.strip(), v.strip())
            except OSError:
                continue
            seen[name] = None
            if fields.get("Type") != "Application" or fields.get("NoDisplay") == "true" or fields.get("Hidden") == "true" or "Exec" not in fields:
                continue
            exec_line = re.sub(r"%[a-zA-Z%]", "", fields["Exec"]).strip()
            seen[name] = {"name": fields.get("Name", name[:-8]), "sub": fields.get("GenericName") or fields.get("Comment", ""),
                          "exec": exec_line, "terminal": fields.get("Terminal") == "true"}
    return sorted((e for e in seen.values() if e), key=lambda e: e["name"].lower())


def score(entry, query):
    if not query:
        return 0
    name = entry["name"].lower()
    if name.startswith(query):
        return 0
    if query in name:
        return 1
    pos = 0
    for ch in query:
        pos = name.find(ch, pos) + 1
        if not pos:
            return None
    return 2


class App:
    def __init__(self, entries):
        self.entries = entries
        self.query = ""
        self.sel = 0
        self.rows = 4
        self.shown = False
        self.result = None

    def matches(self):
        q = self.query.lower()
        scored = [(s, i, e) for i, e in enumerate(self.entries) if (s := score(e, q)) is not None]
        return [e for _, _, e in sorted(scored, key=lambda t: (t[0], t[1]))]


    def render(self):
        found = self.matches()
        self.sel = max(0, min(self.sel, len(found) - 1))
        start = max(0, self.sel - self.rows + 1)
        items = [{"id": str(n), "label": e["name"], "detail": e["sub"][:60]}
                 for n, e in enumerate(found[start:start + self.rows], start)]
        tree = {"id": "launcher", "k": "picker", "p": {
            "size": "screen", "title": "Run", "subtitle": f"{len(found)} of {len(self.entries)} apps",
            "query": self.query, "placeholder": "Type to search", "noun": "apps",
            "total": len(found), "items": items, "order": [item["id"] for item in items],
            "selected": str(self.sel) if found else "", "preview": "none", "focus": "list",
            "empty": "No matches", "actions": [
                {"id": "open", "label": "Open", "keys": ["enter"], "primary": True, **({"disabled": True} if not found else {})},
                {"id": "close", "label": "Close", "keys": ["esc"], "end": True}]
        }}
        tree = {"id": "main", "k": "col", "c": [tree]}
        ops = [["del", "main"]] if self.shown else []
        ops.append(["add", "main", SURFACE, None, tree])
        self.shown = True
        self.seq = getattr(self, "seq", 0) + 1
        send(frame("f", {"sf": SURFACE, "s": self.seq, "ops": ops}))
        return found

    def event(self, value):
        if value.get("id") != "launcher":
            return None
        event = value.get("ev")
        if event in ("select", "activate"):
            item = value.get("item", "")
            if not isinstance(item, str) or not item.isdecimal() or int(item) >= len(self.matches()):
                return None
            self.sel = int(item)
            if event == "activate":
                return self.key("enter", None)
        elif event == "action":
            if value.get("act") == "close":
                return "quit"
            if value.get("act") == "open":
                return self.key("enter", None)
        return None

    def key(self, kind, value):
        found = self.matches()
        if kind in ("char",):
            self.query += value
            self.sel = 0
        elif kind == "backspace":
            self.query = self.query[:-1]
            self.sel = 0
        elif kind == "ctrl" and value == "u":
            self.query = ""
        elif kind in ("down",) or (kind == "ctrl" and value in ("n", "j")):
            self.sel += 1
        elif kind in ("up",) or (kind == "ctrl" and value in ("p", "k")):
            self.sel -= 1
        elif kind == "escape" or (kind == "ctrl" and value in ("c", "g")):
            return "quit"
        elif kind == "enter" and found:
            self.result = found[min(self.sel, len(found) - 1)]
            return "quit"
        return None


def launch(entry, context):
    env = {k: v for k, v in os.environ.items() if not k.startswith("TERN_") and k != "TERM_PROGRAM"}
    for name, value in (("CONFIG_DIR", context["config"]), ("DAEMON_SOCKET", context["socket"])):
        if value:
            env[f"TERN_{name}"] = value
    argv = shlex.split(entry["exec"])
    if entry["terminal"]:
        pane = subprocess.check_output(["tern", "new", "tab", "--", *argv], env=env, text=True, stdin=subprocess.DEVNULL,
                                       cwd=os.path.expanduser("~")).strip()
        subprocess.run(["tern", "focus", pane], env=env, check=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    else:
        subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, cwd=os.path.expanduser("~"))


def main():
    if not sys.stdout.isatty():
        sys.stderr.write("tern-launcher: needs a terminal\n")
        return 1
    context = json.loads(Path(sys.argv[1]).read_text())
    saved = termios.tcgetattr(0)
    raw = list(saved)
    raw[3] &= ~(termios.ECHO | termios.ICANON | termios.ISIG)
    raw[0] &= ~(termios.ICRNL | termios.IXON)
    termios.tcsetattr(0, termios.TCSANOW, raw)
    app = App(desktop_entries())
    buf = ""
    try:
        send(frame("q", {"q": "hello", "v": [1], "app": "tern-launcher", "features": [], "ver": "0.1"}))
        hello = None
        deadline = time.time() + 2
        while hello is None and time.time() < deadline:
            if select.select([0], [], [], 0.1)[0]:
                events, buf = parse(buf + os.read(0, 65536).decode("utf-8", "replace"))
                hello = next((v for k, v in events if k == "tsp" and v.get("r") == "hello"), None)
        if hello is None:
            sys.stderr.write("tern-launcher: no TSP host answered\n")
            return 1
        send(frame("o", {"id": SURFACE, "mode": "screen", "title": "launcher", "role": "tern-run.launcher"}))
        app.render()
        while True:
            ready = select.select([0], [], [], 0.25)[0]
            if not ready:
                if buf == "\x1b":
                    buf = ""
                    if app.key("escape", None) == "quit":
                        break
                continue
            data = os.read(0, 65536).decode("utf-8", "replace")
            if not data:
                break
            events, buf = parse(buf + data)
            previous = app.query, app.sel
            done = False
            for kind, value in events:
                if kind == "tsp":
                    if value.get("ev") == "gone" or app.event(value) == "quit":
                        done = True
                        break
                    continue
                if app.key(kind, value) == "quit":
                    done = True
                    break
            if done:
                break
            if (app.query, app.sel) != previous:
                app.render()
    finally:
        termios.tcsetattr(0, termios.TCSANOW, saved)
    send(frame("x", {"id": SURFACE, "keep": False}))
    if app.result:
        launch(app.result, context)
    return 0


if __name__ == "__main__":
    sys.exit(main())
