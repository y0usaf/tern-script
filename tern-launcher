#!/usr/bin/env python3
import json
import os
import re
import select
import shlex
import subprocess
import sys
import termios
import time

APC = "\x1b_tsp;"
ST = "\x1b\\"
SURFACE = "s:1"
PARAM = re.compile(r"^[A-Za-z0-9_-]+=[\x21-\x3a\x3c-\x7e]*$")
KEYS = {
    "\x1b[A": "up", "\x1b[B": "down", "\x1bOA": "up", "\x1bOB": "down",
    "\r": "enter", "\n": "enter", "\x7f": "backspace", "\x08": "backspace", "\x1b": "escape",
    "\x1b[5~": "pageup", "\x1b[6~": "pagedown",
}
SEQS = sorted(KEYS, key=len, reverse=True)
PREFIXES = [APC] + SEQS
SHEET = """
.tl-root{display:flex;flex-direction:column;height:100%;padding:16px 20px;gap:10px;background:var(--page);color:var(--t1)}
.tl-head{display:flex;align-items:center;gap:10px}
.tl-tag{padding:3px 10px;background:var(--card);color:var(--t1);font-size:.75em;letter-spacing:.08em}
.tl-count{color:var(--t3);font-size:.75em}
.tl-query{font-size:1.4em;padding:8px 12px;background:var(--card);border:1px solid var(--line);border-radius:var(--r-md)}
.tl-hint{color:var(--t3)}
.tl-list{display:flex;flex-direction:column;gap:4px;overflow:hidden;padding:4px 0}
.tl-row{padding:6px 12px;display:flex;justify-content:space-between;align-items:center;border-radius:var(--r-sm);gap:12px}
.tl-row.tl-sel{background:var(--card);color:var(--t1);outline:1px solid var(--accent)}
.tl-name{font-size:1.15em;flex-shrink:0}
.tl-sub{color:var(--t3);font-size:.75em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tl-foot{display:flex;gap:16px;color:var(--t3);font-size:.72em;margin-top:auto}
.tl-hint-item{display:flex;align-items:center;gap:2px}
.tl-key{padding:1px 6px;margin-right:5px;background:var(--card);color:var(--t1);border:1px solid var(--line);border-radius:var(--r-sm)}
"""


def message(verb, params, text):
    base = "".join(f";{k}={v}" for k, v in params.items())
    return f"{APC}{verb}{base};{text}{ST}"


def frame(verb, body):
    return message(verb, {}, json.dumps(body, separators=(",", ":")))


def send(text):
    data = text.encode()
    while data:
        data = data[os.write(1, data):]


def parse(data):
    out = []
    i = 0
    while i < len(data):
        if data.startswith(APC, i):
            end = data.find(ST, i)
            if end == -1:
                break
            verb, _, rest = data[i + len(APC):end].partition(";")
            parts = rest.split(";")
            while parts and PARAM.match(parts[0]):
                parts.pop(0)
            try:
                payload = json.loads(";".join(parts))
            except ValueError:
                payload = None
            if verb in ("r", "e") and isinstance(payload, dict):
                out.append(("tsp", payload))
            i = end + len(ST)
            continue
        tail = data[i:]
        if any(len(s) > len(tail) and s.startswith(tail) for s in PREFIXES):
            break
        for seq in SEQS:
            if data.startswith(seq, i):
                out.append((KEYS[seq], None))
                i += len(seq)
                break
        else:
            ch = data[i]
            out.append(("char", ch) if ord(ch) >= 32 else ("ctrl", chr(ord(ch) + 96)))
            i += 1
    return out, data[i:]


def desktop_entries():
    dirs = [os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "applications")]
    dirs += [os.path.join(d, "applications") for d in os.environ.get("XDG_DATA_DIRS", "/run/current-system/sw/share").split(":") if d]
    seen = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".desktop") or name in seen:
                continue
            fields = {}
            section = None
            try:
                with open(os.path.join(d, name), encoding="utf-8", errors="replace") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("["):
                            section = line
                        elif section == "[Desktop Entry]" and "=" in line:
                            k, _, v = line.partition("=")
                            fields.setdefault(k.strip(), v.strip())
            except OSError:
                continue
            seen[name] = None
            if fields.get("Type") != "Application" or fields.get("NoDisplay") == "true" or fields.get("Hidden") == "true" or "Exec" not in fields:
                continue
            exec_line = re.sub(r"%[a-zA-Z%]", "", fields["Exec"]).strip()
            seen[name] = {"name": fields.get("Name", name[:-8]), "sub": fields.get("GenericName") or fields.get("Comment", ""),
                          "exec": exec_line, "terminal": fields.get("Terminal") == "true"}
    return sorted((e for e in seen.values() if e), key=lambda e: e["name"].lower())


def score(entry, query):
    if not query:
        return 0
    name = entry["name"].lower()
    if name.startswith(query):
        return 0
    if query in name:
        return 1
    pos = 0
    for ch in query:
        pos = name.find(ch, pos) + 1
        if not pos:
            return None
    return 2


class App:
    def __init__(self, entries):
        self.entries = entries
        self.query = ""
        self.sel = 0
        self.rows = 6
        self.shown = False
        self.result = None

    def matches(self):
        q = self.query.lower()
        scored = [(s, i, e) for i, e in enumerate(self.entries) if (s := score(e, q)) is not None]
        return [e for _, _, e in sorted(scored, key=lambda t: (t[0], t[1]))]

    def el(self, nid, cls, kids=None, text=None):
        p = {"tag": "div", "class": cls}
        if text is not None:
            p["text"] = text
        node = {"id": nid, "k": "el", "p": p}
        if kids:
            node["c"] = kids
        return node

    def render(self):
        found = self.matches()
        self.sel = max(0, min(self.sel, len(found) - 1))
        start = max(0, self.sel - self.rows + 1)
        rows = []
        for n, e in enumerate(found[start:start + self.rows], start):
            rows.append(self.el(f"r{n - start}", "tl-row tl-sel" if n == self.sel else "tl-row",
                                [self.el(f"r{n - start}.n", "tl-name", text=e["name"]),
                                 self.el(f"r{n - start}.s", "tl-sub", text=e["sub"][:60])]))
        query = self.query or "Type to search"
        keys = [("↵", "open"), ("↑↓", "move"), ("esc", "close")]
        foot = [self.el(f"k{i}", "tl-hint-item", [self.el(f"k{i}.k", "tl-key", text=k), self.el(f"k{i}.t", "tl-ktext", text=t)])
                for i, (k, t) in enumerate(keys)]
        tree = self.el("main", "tl-root", [
            self.el("head", "tl-head", [self.el("tag", "tl-tag", text="RUN"),
                                        self.el("count", "tl-count", text=f"{len(found)} of {len(self.entries)} apps")]),
            self.el("q", "tl-query" if self.query else "tl-query tl-hint", text=query),
            self.el("list", "tl-list", rows or [self.el("none", "tl-row tl-hint", text="No matches")]),
            self.el("foot", "tl-foot", foot),
        ])
        ops = [["del", "main"]] if self.shown else []
        ops.append(["add", "main", SURFACE, None, tree])
        self.shown = True
        self.seq = getattr(self, "seq", 0) + 1
        send(frame("f", {"sf": SURFACE, "s": self.seq, "ops": ops}))
        return found

    def key(self, kind, value):
        found = self.matches()
        if kind in ("char",):
            self.query += value
            self.sel = 0
        elif kind == "backspace":
            self.query = self.query[:-1]
            self.sel = 0
        elif kind == "ctrl" and value == "u":
            self.query = ""
        elif kind in ("down",) or (kind == "ctrl" and value in ("n", "j")):
            self.sel += 1
        elif kind in ("up",) or (kind == "ctrl" and value in ("p", "k")):
            self.sel -= 1
        elif kind == "escape" or (kind == "ctrl" and value in ("c", "g")):
            return "quit"
        elif kind == "enter" and found:
            self.result = found[min(self.sel, len(found) - 1)]
            return "quit"
        return None


def launch(entry):
    env = {k: v for k, v in os.environ.items() if not k.startswith("TERN_") and k != "TERM_PROGRAM"}
    for name in ("CONFIG_DIR", "DAEMON_SOCKET"):
        outer = os.environ.get(f"TERN_RUN_OUTER_{name}")
        if outer:
            env[f"TERN_{name}"] = outer
    argv = shlex.split(entry["exec"])
    if entry["terminal"]:
        argv = ["tern", "new", "tab", "--", *argv]
    subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True, cwd=os.path.expanduser("~"))


def main():
    if not sys.stdout.isatty():
        sys.stderr.write("tern-launcher: needs a terminal\n")
        return 1
    saved = termios.tcgetattr(0)
    raw = list(saved)
    raw[3] &= ~(termios.ECHO | termios.ICANON | termios.ISIG)
    raw[0] &= ~(termios.ICRNL | termios.IXON)
    termios.tcsetattr(0, termios.TCSANOW, raw)
    app = App(desktop_entries())
    buf = ""
    try:
        send(frame("q", {"q": "hello", "v": [1], "app": "tern-launcher", "features": [], "ver": "0.1"}))
        hello = None
        deadline = time.time() + 2
        while hello is None and time.time() < deadline:
            if select.select([0], [], [], 0.1)[0]:
                events, buf = parse(buf + os.read(0, 65536).decode("utf-8", "replace"))
                hello = next((v for k, v in events if k == "tsp" and v.get("r") == "hello"), None)
        if hello is None:
            sys.stderr.write("tern-launcher: no TSP host answered\n")
            return 1
        send(frame("o", {"id": SURFACE, "mode": "screen", "title": "launcher", "role": "tern-script.launcher"}))
        send(frame("s", {"sf": SURFACE, "name": "launcher", "css": SHEET}))
        app.render()
        while True:
            ready = select.select([0], [], [], 0.25)[0]
            if not ready:
                if buf == "\x1b":
                    buf = ""
                    if app.key("escape", None) == "quit":
                        break
                continue
            data = os.read(0, 65536).decode("utf-8", "replace")
            if not data:
                break
            events, buf = parse(buf + data)
            done = False
            for kind, value in events:
                if kind == "tsp":
                    if value.get("ev") == "gone":
                        done = True
                    continue
                if app.key(kind, value) == "quit":
                    done = True
                    break
            if done:
                break
            app.render()
    finally:
        termios.tcsetattr(0, termios.TCSANOW, saved)
    send(frame("x", {"id": SURFACE, "keep": False}))
    if app.result:
        launch(app.result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
