#!/usr/bin/env python3
import contextlib
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

if len(sys.argv) < 2:
    sys.exit("usage: tern-script PROGRAM [ARGS...]")
signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
signal.signal(signal.SIGHUP, lambda *_: sys.exit(129))
here = Path(__file__).resolve().parent
program = [str(Path(sys.argv[1]).resolve()) if os.sep in sys.argv[1] else sys.argv[1], *sys.argv[2:]]
name = Path(sys.argv[1]).name
config = Path(os.environ.get("TERN_CONFIG_DIR") or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "tern")
state = config if os.environ.get("TERN_CONFIG_DIR") else Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "tern"
with tempfile.TemporaryDirectory(prefix="tern-script.", dir=os.environ.get("XDG_RUNTIME_DIR")) as temporary:
    run = Path(temporary)
    cfg = run / "config"
    plugin = cfg / "plugins" / "tern-script"
    plugin.mkdir(parents=True)
    settings = json.loads((config / "settings.json").read_text()) if (config / "settings.json").exists() else {}
    settings = {k: v for k, v in settings.items() if k in {"theme", "theme_dark", "theme_light", "font_size", "ui_font_size", "font_family", "font_family_bold", "font_family_italic", "font_family_bold_italic", "ui_font", "code_font", "material", "opacity", "blur", "contrast", "renderer", "snap_text"}}
    settings.update(status_bar=False, system_title_bar=False, padding_x=0, padding_y=0)
    (cfg / "settings.json").write_text(json.dumps(settings))
    if (config / "themes").exists():
        (cfg / "themes").symlink_to(config / "themes")
    preference = state / "plugin-data/ui-menu/kv.json"
    active = json.loads(preference.read_text()).get("on", {}) if preference.exists() else {}
    sheets = []
    for look, enabled in active.items():
        sheet = config / "plugins/ui-menu/snippets" / (look + ".css")
        if enabled and sheet.exists():
            (plugin / sheet.name).symlink_to(sheet)
            sheets.append(f"tern.css({json.dumps('tern-script-' + look)}, tern.fs.read(tern.plugin.dir .. {json.dumps('/' + sheet.name)}))")
    (plugin / "bare.css").symlink_to(here / "bare.css")
    (plugin / "window.luau").write_text("\n".join(sheets) + "\n")
    (plugin / "plugin.toml").write_text('schema = 1\nid = "tern-script"\nname = "tern-script"\nversion = "0.1.0"\nwindow = "window.luau"\nstyles = ["bare.css"]\n')
    (cfg / "welcomed").touch()
    env = dict(os.environ, TERN_CONFIG_DIR=str(cfg), TERN_DAEMON_SOCKET=str(run / "daemon.sock"))
    daemon = subprocess.Popen(["tern", "daemon", "--socket", env["TERN_DAEMON_SOCKET"]], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        deadline = time.monotonic() + 5
        while not (run / "daemon.sock").exists():
            if daemon.poll() is not None or time.monotonic() >= deadline:
                sys.exit("tern-script: Tern daemon did not start")
            time.sleep(0.01)
        caller = [f"{k}={v}" for k, v in os.environ.items() if not k.startswith(("TERN_", "TERM")) and k != "COLORTERM"]
        pending = subprocess.Popen(["tern", "new", "session", name, "--", shutil.which("env"), *caller, *program], env=env, text=True, stdout=subprocess.PIPE)
        window = subprocess.Popen(["tern", "--control", str(run / "control.sock")], env=env, cwd="/", start_new_session=True)
        try:
            pane, _ = pending.communicate()
            if pending.returncode:
                sys.exit(f"tern-script: cannot start {program[0]}")
            pane = pane.strip()
            subprocess.run(["tern", "focus", pane], env=env, check=True, stdout=subprocess.DEVNULL)
            waiter = subprocess.Popen(["tern", "wait", pane, "--until", "exit"], env=env)
            try:
                while window.poll() is None and waiter.poll() is None:
                    time.sleep(0.05)
            finally:
                waiter.terminate()
                waiter.wait()
        finally:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(window.pid, signal.SIGTERM)
            window.wait()
    finally:
        daemon.terminate()
        daemon.wait()
